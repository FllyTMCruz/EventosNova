@startuml Secuencia_CU04_Alternativa
' Diagrama 2 (Rol 2) - CU-04 Procesar cambio de alcance, flujo de excepción
' Reglas: BR-02 (límite de 7 días), BR-12 (cambios fuera de plazo), BR-08 (costo).
' Decisiones: D1, D4, D5, D8 y ADR-002.

title CU-04 Procesar cambio de alcance: cambio extemporáneo no viable\nBR-02, BR-12 | Command: ProcesarCambioAlcanceCommand
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 8
autonumber

actor Coordinador
participant "ControlAccesoRBAC\n<<interceptor, ADR-002>>" as RBAC
participant "ProcesarCambioAlcanceHandler\n<<Application Service>>" as H
participant "IEventoRepository\n<<interfaz>>" as ERepo
participant "Evento\n<<Aggregate Root>>" as Evento
participant "IUnitOfWork\n<<interfaz, provisional>>" as UoW
participant "IDespachadorEventos\n<<interfaz>>" as Desp
database "Base de datos\n(un solo almacén)" as BD
participant "ManejadorCambioRegistrado\n<<Event Handler>>" as MCR
participant "IRegistroAuditoriaRepository\n<<interfaz, solo append>>" as ARepo

Coordinador -> RBAC : procesarCambioAlcance(eventoId, cambio,\nfechaSolicitud, viabilidadConfirmada = false)
note left of Coordinador
  El Coordinador consulta la viabilidad
  con los proveedores y manda el resultado
  como booleano (BPMN y US-12).
end note
activate RBAC
RBAC -> RBAC : verifica que el rol esté autorizado para el CU-04
RBAC -> H : manejar(ProcesarCambioAlcanceCommand)\ncon userId y rol de la sesión
deactivate RBAC
activate H

H -> ERepo : obtenerPorId(eventoId)
ERepo -> BD : leer el agregado Evento
BD --> ERepo : datos del Evento
ERepo --> H : Evento

group Transacción 1: agregado Evento
  H -> Evento : solicitarCambioAlcance(cambio, fechaSolicitud,\nviabilidadConfirmada, userId, rol)
  activate Evento
  Evento -> Evento : calcula fechaEvento - fechaSolicitud\ny la compara con el límite de 7 días (BR-02)
  alt faltan menos de 7 días y viabilidadConfirmada = false (este escenario)
    Evento -> Evento : rechaza el cambio y lo marca "No garantizado" (BR-12)\nregistra CambioRegistrado *
    Evento --> H : ResultadoCambio.NoGarantizado
  else faltan menos de 7 días y viabilidadConfirmada = true
    Evento -> Evento : genera la CotizacionIncremento\nen espera de aceptación (BR-08)
    Evento --> H : ResultadoCambio.CotizacionPendienteDeAceptacion
  end
  deactivate Evento
  note right of Evento
    * Supuesto: el rechazo se audita con CambioRegistrado.
    Falta confirmarlo con Rol 1.
    El cambio con 7 días o más sigue BR-06 y BR-08
    y queda fuera de este diagrama.
  end note

  H -> Evento : extraerEventosDeDominio()
  Evento --> H : [CambioRegistrado]
  H -> ERepo : guardar(evento)
  ERepo -> BD : registrar los cambios del Evento
  H -> UoW : confirmar()
  UoW -> BD : commit
end

H ->> Desp : publicar(CambioRegistrado)
H --> Coordinador : Result.exito(ResultadoCambioAlcance:\nresultado = NoGarantizado)
deactivate H
note over H, Coordinador
  "No garantizado" es un desenlace de negocio previsto,
  por eso vuelve como Result.exito y no como excepción.
end note

note over Desp
  No se emite AlcanceModificado porque el alcance no cambió.
  CuentaDePagos no participa en este flujo.
end note

== Reacción después del commit ==

Desp ->> MCR : manejar(CambioRegistrado:\nuserId, rol, tipo de cambio, fecha)
activate MCR
group Transacción 2: registro de auditoría (ADR-003)
  MCR -> ARepo : agregar(registro de auditoría)
  ARepo -> BD : insertar fila nueva, sin modificar las anteriores
  MCR -> UoW : confirmar()
  UoW -> BD : commit
end
deactivate MCR

footer Equipo 16 | Eventos Nova 
@enduml
