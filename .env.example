# .env.example
# Configuración de Base de Datos (PostgreSQL para producción / SQLite para desarrollo local)
POSTGRES_USER=nova_admin
POSTGRES_PASSWORD=reemplazar_con_password_seguro
POSTGRES_DB=eventos_nova
DATABASE_URL=postgresql+psycopg2://nova_admin:reemplazar_con_password_seguro@localhost:5432/eventos_nova

# Seguridad y Entorno de Aplicación
SECRET_KEY=reemplazar_con_llave_hexadecimal_de_64_caracteres
ENVIRONMENT=development
LOG_LEVEL=INFO
